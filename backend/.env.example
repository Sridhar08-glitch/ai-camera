# Phase 1 backend environment — copy to `.env` and fill in real values.
# `.env` is git-ignored. Never commit real secrets.

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-generate-a-50-char-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL — least-privilege application role (ADR-014). The postgres superuser
# is used ONLY by scripts/create_app_role.ps1 (one-time bootstrap).
DATABASE_URL=postgresql://aitraffic_app:CHANGE_ME@127.0.0.1:5432/aitraffic

# Redis (Memurai native on Windows, port 6379).
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# JWT
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
# Refresh-token cookie
REFRESH_COOKIE_NAME=refresh_token
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=Lax
REFRESH_COOKIE_DOMAIN=

# CORS / frontend origin
CORS_ALLOWED_ORIGINS=http://localhost:3000

# WebSocket
WS_HEARTBEAT_SECONDS=20

# Logging
LOG_LEVEL=INFO
LOG_JSON=true

# Phase 2 — governance / retention / metrics
ARTIFACT_ROOT=./artifacts
RETENTION_ENABLED=true
RETENTION_MAX_DELETES_PER_RUN=100000
METRIC_SAMPLE_INTERVAL_SECONDS=60
